{
  "name": "ai-farma-app",
  "version": "1.0.0",
  "description": "AI-powered pharmacy locator and medication advisor for Chile",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
